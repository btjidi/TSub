#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034,SC1091
name="TSub Controller"
if [ -r /etc/tsub-controller/controller.env ]; then
  set -a
  # Generated by the installer with shell-safe quoted values.
  . /etc/tsub-controller/controller.env
  set +a
fi
command="/usr/bin/node"
command_args="/opt/tsub-controller/server/index.mjs"
command_user="tsub-controller:tsub-controller"
directory="/opt/tsub-controller"
command_background=true
pidfile="/run/tsub-controller.pid"
output_log="/var/log/tsub-controller.log"
error_log="/var/log/tsub-controller.log"
depend() { need net; }
