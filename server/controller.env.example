TSUB_PLATFORM=server
TSUB_STORAGE_TYPE=sqlite
TSUB_DATA_DIR=/var/lib/tsub-controller
TSUB_SQLITE_PATH=/var/lib/tsub-controller/tsub.sqlite
# 配置后可在系统设置中执行 SQLite 与 PostgreSQL 的可恢复迁移。
# TSUB_POSTGRES_URL=postgresql://tsub:replace-me@127.0.0.1:5432/tsub
# Docker image path. The bare-metal installer writes its own /opt path.
TSUB_STATIC_DIR=/app/dist
TSUB_LOCAL_EXECUTOR_SOCKET=/run/tsub/controller.sock
TSUB_DOMAIN=tsub.example.com
TSUB_PUBLIC_URL=https://tsub.example.com
TSUB_TRUST_PROXY=loopback
DEPLOYMENT_SECRET_KEY=replace-with-a-random-32-byte-secret
SETTINGS_SECRET_KEY=replace-with-a-different-random-32-byte-secret
COOKIE_SECRET=replace-with-a-different-random-32-byte-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
