{
  "name": "tsub",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "runtime:build": "node scripts/build-runtime.mjs",
    "runtime:check": "node scripts/check-runtime.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:screenshots": "node scripts/capture-doc-screenshots.mjs",
    "dev": "vite",
    "dev:server": "npx wrangler pages dev public --port 8787",
    "server:start": "node server/index.mjs",
    "build": "npm run runtime:build && vite build && node scripts/check-runtime.mjs --dist",
    "preview": "vite preview",
    "pages:verify": "node scripts/deploy-pages.mjs",
    "deploy:pages": "npm run build && node scripts/deploy-pages.mjs --deploy",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dompurify": "^3.4.14",
    "js-yaml": "^4.3.1",
    "pg": "^8.16.3",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.18",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.1.1",
    "miniflare": "^4.20260730.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.12",
    "terser": "^5.48.0",
    "vite": "^7.1.2",
    "vitest": "4.1.10",
    "wrangler": "^4.126.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "undici": "7.29.0"
  }
}
